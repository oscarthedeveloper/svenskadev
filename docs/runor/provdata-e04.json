          }
        },
        "runic_texts": [
          {
            "reading": "buonti × kuþr × hulmkoetr × lit × resa × ufteʀ × oþintisu × kunu × seno × kumbr × hifrya × til × hasmuimura × iki betr × þon × byi raþr roþbalir × risti × runi × þisa × sikmuntaʀ × uaʀ … sestʀ × kuþ",
            "reference": "P",
            "interpretations": [
              {
                "text": "Bóndi góðr Holmgautr lét reisa eptir Óðindísu, konu sína. Kemr hýfreyja til Hǫsumýra eigi betri, en býi ráðr. Rauð-Ballir risti rúnar þessar. Sigmundar var [Óðindísa] systir góð.",
                "language": {
                  "language_code": "FVN",
                  "sv": "Fornvästnordiska",
                  "en": "Old West Norse",
                  "inscriptions": null,
                  "position": null
                }
              },
              {
                "text": "Boandi goðr Holmgautr let ræisa æftiʀ Oðindisu, kunu sina. Kumbʀ hifrøya til Hasumyra æigi bætri, þan byi raðr. Rauð-Balliʀ risti runiʀ þessaʀ. Sigmundaʀ vaʀ [Oðindisa] systiʀ goð.",
                "language": {
                  "language_code": "RSV",
                  "sv": "Runsvenska",
                  "en": "Runic Swedish",
                  "inscriptions": null,
                  "position": null
                }
              }
            ],
            "translations": [
              {
                "translation": "The good husbandman Holmgautr had (the stone) raised in memory of Óðindísa, his wife. There will come to Hǫsumýrar no better housewife, who arranges the estate. Red-Balli carved these runes. Óðindísa was a good sister to Sigmundr.",
                "language": {
                  "language_code": "en-gb",
                  "sv": "Engelska",
                  "en": "English",
                  "inscriptions": null,
                  "position": null
                }
              }
            ]
          }
