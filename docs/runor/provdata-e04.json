        "runic_texts": [
          {
            "reading": "§A · rahnualtr · lit · rista · runar · efʀ · fastui · moþur · sina · onems · totʀ · to i · aiþi · kuþ hialbi · ant · hena · §B runa · rista · lit · rahnualtr · huar a × griklanti · uas · lis · forunki ·",
            "reference": "P",
            "interpretations": [
              {
                "text": "§A Ragnvaldr lét rista rúnar eptir Fastvé, móður sína, Ónæms dóttir, dó í Eiði. Guð hjalpi ǫnd hennar. §B Rúnar rista lét Ragnvaldr. Var á Grikklandi, var liðs forungi.",
                "language": {
                  "language_code": "FVN",
                  "sv": "Fornvästnordiska",
                  "en": "Old West Norse",
                  "inscriptions": null,
                  "position": null
                }
              },
              {
                "text": "§A Ragnvaldr let rista runaʀ æftiʀ Fastvi, moður sina, Onæms dottiʀ, do i Æiði. Guð hialpi and hænnaʀ. §B Runaʀ rista let Ragnvaldr. Vaʀ a Grikklandi, vas liðs forungi.",
                "language": {
                  "language_code": "RSV",
                  "sv": "Runsvenska",
                  "en": "Runic Swedish",
                  "inscriptions": null,
                  "position": null
                }
              }
            ],
            "translations": [
              {
                "translation": "§A Ragnvaldr had the runes carved in memory of Fastvé, his mother, Ónæmr's daughter, (who) died in Eið. May God help her spirit. §B Ragnvaldr had the runes carved; (he) was in Greece, was commander of the retinue.",
