            "uuid": "b75ae556-a4b7-44cf-a363-0f5e6f027ed0"
          }
        },
        "runic_texts": [
          {
            "reading": "× tula : lit : raisa : stain : þinsa| |at : sun : sin : haralt : bruþur : inkuars : þaiʀ furu : trikila : fiari : at : kuli : auk : a:ustarla| |ar:ni : kafu : tuu : sunar:la : a sirk:lan:ti",
            "reference": "P",
            "interpretations": [
              {
                "text": "Tóla lét reisa stein þenna at son sinn Harald, bróður Ingvars. Þeir fóru drengila fjarri at gulli ok austarla erni gáfu, dóu sunnarla á Serklandi.",
                "language": {
                  "language_code": "FVN",
                  "sv": "Fornvästnordiska",
                  "en": "Old West Norse",
                  "inscriptions": null,
                  "position": null
                }
              },
              {
                "text": "Tola let ræisa stæin þennsa at sun sinn Harald, broður Ingvars. Þæiʀ foru drængila fiarri at gulli ok austarla ærni gafu, dou sunnarla a Særklandi.",
                "language": {
                  "language_code": "RSV",
                  "sv": "Runsvenska",
                  "en": "Runic Swedish",
                  "inscriptions": null,
                  "position": null
                }
              }
            ],
            "translations": [
              {
                "translation": "Tóla had this stone raised in memory of her son Haraldr, Ingvarr's brother. They travelled valiantly far for gold, and in the east gave (food) to the eagle. (They) died in the south in Serkland.",
                "language": {
                  "language_code": "en-gb",
                  "sv": "Engelska",
                  "en": "English",
                  "inscriptions": null,
                  "position": null
                }
              },
              {
                "translation": "Tola lät resa denna sten efter sin son Harald, Ingvars broder. De for manligen fjärran efter guld och österut gav örnen (mat), de dog söderut i Särkland.",
                "language": {
                  "language_code": "sv-se",
                  "sv": "Svenska",
                  "en": "Swedish",
                  "inscriptions": null,
                  "position": null
                }
              }
            ]
          }
