        "runic_texts": [
          {
            "reading": ": kutraþr : karþi : kubl : þisi : iftiʀ : astraþ : faþur : sin : þan : frita : ak : þih:na : bistan : iʀ a : fin:iþi : forþum : uf| |faʀi :",
            "reference": "P",
            "interpretations": [
              {
                "text": "Gautráðr gerði kuml þessi eptir Ástráð, fǫður sinn, þann frænda ok þegna beztan, er á Finnheiði forðum of væri.",
                "language": {
                  "language_code": "FVN",
                  "sv": "Fornvästnordiska",
                  "en": "Old West Norse",
                  "inscriptions": null,
                  "position": null
                }
              },
              {
                "text": "Gautraðr gærði kumbl þessi æftiʀ Astrað, faður sinn, þann frænda ok þegna bæztan, eʀ a Finnhæiði forðum of vaʀi.",
                "language": {
                  "language_code": "RSV",
                  "sv": "Runsvenska",
                  "en": "Runic Swedish",
                  "inscriptions": null,
                  "position": null
                }
              }
            ],
            "translations": [
              {
                "translation": "Gautráðr made these monuments in memory of Ástráðr, his father, the best of kinsmen and Þegns, who formerly was in Finnheiðr.",
                "language": {
                  "language_code": "en-gb",
                  "sv": "Engelska",
                  "en": "English",
                  "inscriptions": null,
                  "position": null
                }
              },
              {
                "translation": "Götrad gjorde detta minnesmärke efter Åstrad, sin fader, den bäste av fränder och tägnar som i Finnveden fordom var.",
                "language": {
                  "language_code": "sv-se",
                  "sv": "Svenska",
                  "en": "Swedish",
                  "inscriptions": null,
                  "position": null
                }
