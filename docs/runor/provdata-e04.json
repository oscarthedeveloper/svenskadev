        "runic_texts": [
          {
            "reading": "siriþr : kiarþi : bur : þosi : muþiʀ : alriks : tutiʀ : urms : fur · salu : hulmkirs : faþur : sukruþar buata · sis ·",
            "reference": "P",
            "interpretations": [
              {
                "text": "Sigríðr gerði brú þessa, móðir Alríks, dóttir Orms, fyrir sálu Holmgeirs, fǫður Sigrøðar, bónda síns.",
                "language": {
                  "language_code": "FVN",
                  "sv": "Fornvästnordiska",
                  "en": "Old West Norse",
                  "inscriptions": null,
                  "position": null
                }
              },
              {
                "text": "Sigriðr gærði bro þasi, moðiʀ Alriks, dottiʀ Orms, for salu Holmgæiʀs, faður Sigrøðaʀ, boanda sins.",
                "language": {
                  "language_code": "RSV",
                  "sv": "Runsvenska",
                  "en": "Runic Swedish",
                  "inscriptions": null,
                  "position": null
                }
              }
            ],
            "translations": [
              {
                "translation": "Sigríðr, Alríkr's mother, Ormr's daughter, made this bridge for the soul of Holmgeirr, father of Sigrøðr, her husbandman.",
                "language": {
                  "language_code": "en-gb",
                  "sv": "Engelska",
                  "en": "English",
                  "inscriptions": null,
                  "position": null
                }
              },
              {
                "translation": "Sigrid gjorde denna bro, Alriks moder, Orms dotter, för Holmgers själ, Sygröds faders, sin makes.",
                "language": {
                  "language_code": "sv-se",
                  "sv": "Svenska",
                  "en": "Swedish",
                  "inscriptions": null,
                  "position": null
                }
              }
            ]
          }
