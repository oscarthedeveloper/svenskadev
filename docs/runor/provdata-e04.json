          }
        },
        "runic_texts": [
          {
            "reading": "kufi : rsþi : stin : þesi : eftʀ : ulaf : sun : sin · trk · hrþa · kuþan · hn · uarþ · trbin · i · estlatum · hu(a)rþ(r) · iuk · s---",
            "reference": "P",
            "interpretations": [
              {
                "text": "Gufi reisti stein þenna eptir Ólaf, son sinn, dreng harða góðan. Hann varð drepinn í Eistlǫndum. Hávarðr(?) hjó s[tein].",
                "language": {
                  "language_code": "FVN",
                  "sv": "Fornvästnordiska",
                  "en": "Old West Norse",
                  "inscriptions": null,
                  "position": null
                }
              },
              {
                "text": "Gufi ræisti stæin þennsi æftiʀ Olaf, sun sinn, dræng harða goðan. Hann varð drepinn i Æistlandum. Havarðr(?) hiogg s[tæin].",
                "language": {
                  "language_code": "RSV",
                  "sv": "Runsvenska",
                  "en": "Runic Swedish",
                  "inscriptions": null,
                  "position": null
                }
              }
            ],
            "translations": [
              {
                "translation": "Gufi raised this stone in memory of Ólafr, his son, a very good valiant man. He was killed in Estonia. Hávarðr(?) cut the stone.",
                "language": {
                  "language_code": "en-gb",
                  "sv": "Engelska",
                  "en": "English",
                  "inscriptions": null,
                  "position": null
                }
              },
              {
                "translation": "Guve reste denna sten efter Olav, sin son, en mycket dugande ung man. Han blev dräpt i Estland. Håvard(?) högg stenen.",
                "language": {
                  "language_code": "sv-se",
                  "sv": "Svenska",
                  "en": "Swedish",
                  "inscriptions": null,
                  "position": null
                }
              }
            ]
          }
        ],
